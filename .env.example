PORT=4000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public&connection_limit=10&pool_timeout=5"

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300
RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://vectordb:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CONVERSATION_MAX_MESSAGES=20

JWT_SECRET=change_me_access_token_secret
JWT_REFRESH_SECRET=change_me_refresh_token_secret
JWT_SECRET_REFRESH_KEY=change_me_refresh_token_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
