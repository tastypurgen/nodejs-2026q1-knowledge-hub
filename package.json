{
  "name": "nodejs-2026q1-knowledge-hub",
  "version": "1.0.0",
  "description": "Nest.js Knowledge Hub API with in-memory data storage",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"spec/**/*.ts\"",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:auth": "cross-env TEST_MODE=auth jest --config jest.config.cjs --testRegex \"test/auth/.*\\.spec\\.ts$\" --runInBand",
    "test:refresh": "cross-env TEST_MODE=auth jest --config jest.config.cjs --testRegex \"test/refresh/.*\\.spec\\.ts$\" --runInBand",
    "test:rbac": "cross-env TEST_MODE=auth jest --config jest.config.cjs --testRegex \"test/rbac/.*\\.spec\\.ts$\" --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.4.5",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.18",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
